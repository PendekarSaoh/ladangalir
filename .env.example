# Public values, inlined into the static GitHub Pages build. Both are safe to publish.
# Leave them empty to run the app on on-device storage instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only the retired server build needed these. Never set them for the static site.
# SUPABASE_STORAGE_ENABLED=
# SUPABASE_SECRET_KEY=
